rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }

    function membershipPath(teamId, memberId) {
      return /databases/$(database)/documents/teamMemberships/$(teamId + '__' + memberId);
    }

    function currentUserExists() {
      return isAuthenticated() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    // --- Membership-aware helpers (Phase 3 bridge) -------------------------

    function currentMembership(teamId) {
      return get(membershipPath(teamId, request.auth.uid)).data;
    }

    function hasActiveMembership(teamId) {
      return exists(membershipPath(teamId, request.auth.uid))
        && currentMembership(teamId).active == true;
    }

    // Membership-only authorization (Phase 7). The legacy `users.teamId`/
    // `users.role` mirror is no longer an authorization source: it can be set
    // by the client to any team, so deriving access from it would let a user
    // read teams they don't belong to.
    function belongsToTeam(teamId) {
      return currentUserExists()
        && hasActiveMembership(teamId);
    }

    function isTeamCoach(teamId) {
      return currentUserExists()
        && exists(membershipPath(teamId, request.auth.uid))
        && currentMembership(teamId).active == true
        && currentMembership(teamId).role == 'admin';
    }

    function isTeamOwner(teamId, userId) {
      return exists(teamPath(teamId))
        && get(teamPath(teamId)).data.createdBy == userId;
    }

    function hasValidUserShape(data) {
      return data.email is string
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.role in ['admin', 'player']
        && (data.teamId == null || data.teamId is string)
        && (
          data.get('teamJoinedAt', null) == null
          || data.get('teamJoinedAt', null) is timestamp
        )
        && data.active is bool
        && data.get('managedByCoach', false) is bool
        && data.get('attendanceDefaultStatus', 'attending')
          in ['attending', 'absent']
        && data.get('attendanceDefaultHistory', []) is list;
    }

    function hasValidMembershipShape(data) {
      return data.teamId is string
        && data.memberId is string
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.email is string
        && data.role in ['admin', 'player']
        && data.active is bool
        && data.get('managedByCoach', false) is bool
        && (data.userId == null || data.userId is string)
        && data.get('membershipPeriods', []) is list
        && data.get('attendanceDefaultStatus', 'attending')
          in ['attending', 'absent']
        && data.get('attendanceDefaultHistory', []) is list
        && (
          data.get('migrationVersion', null) == null
          || data.get('migrationVersion', null) is int
        );
    }

    function hasValidAttendanceShape(data) {
      return data.status in [
          'attending',
          'injured',
          'court_only',
          'gym_only',
          'late',
          'absent',
          'late_unannounced',
          'absent_unannounced',
          'absent_late_notice',
          'no_convocado'
        ]
        && (data.note == null
          || (data.note is string && data.note.size() <= 180))
        && data.updatedBy == request.auth.uid;
    }

    function isPlayerAttendanceStatus(status) {
      return status in [
        'attending',
        'injured',
        'court_only',
        'gym_only',
        'late',
        'absent'
      ];
    }

    match /teams/{teamId} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'name',
          'joinCode',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.joinCode == teamId
        && request.resource.data.joinCode.matches('^[A-HJ-KM-NP-Z2-9]{6}$')
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTeamCoach(teamId)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 30
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.joinCode == resource.data.joinCode;
      allow delete: if isTeamCoach(teamId);

      // Server-maintained mirror of each member's explicit attendance
      // statuses across every session (see functions/src/attendanceIndex.ts),
      // read by the Dart client instead of one listener per session. Only
      // the Admin SDK (the attendanceIndexSync trigger / rebuild endpoint)
      // writes it; the read grant matches what a client can already see by
      // reading every session's attendance subcollection directly.
      match /attendanceIndex/{memberId} {
        allow read: if belongsToTeam(teamId);
        allow write: if false;
      }
    }

    match /teamInvites/{teamId} {
      function hasValidInvitationShape() {
        return request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 30;
      }

      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated()
        && hasValidInvitationShape()
        && existsAfter(teamPath(teamId))
        && (
          getAfter(teamPath(teamId)).data.createdBy == request.auth.uid
          || isTeamCoach(teamId)
        );
      allow update: if hasValidInvitationShape() && isTeamCoach(teamId);
      allow delete: if isTeamCoach(teamId);
    }

    match /users/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId
          || (resource.data.teamId != null
            && belongsToTeam(resource.data.teamId)));

      allow create: if isAuthenticated()
        && hasValidUserShape(request.resource.data)
        && request.resource.data.role == 'player'
        && request.resource.data.active == true
        && request.resource.data.attendanceDefaultStatus == 'attending'
        && request.resource.data.attendanceDefaultHistory.size() == 0
        && (
          (
            request.auth.uid == userId
            && request.resource.data.teamId == null
            && request.resource.data.get('teamJoinedAt', null) == null
            && request.resource.data.get('managedByCoach', false) == false
          )
          || (
            request.auth.uid != userId
            && request.resource.data.teamId is string
            && request.resource.data.email == ''
            && request.resource.data.get('managedByCoach', false) == true
            && request.resource.data.teamJoinedAt == request.time
            && isTeamCoach(request.resource.data.teamId)
          )
        );

      allow update: if isAuthenticated()
        && hasValidUserShape(request.resource.data)
        && (
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'fullName',
                'teamId',
                'teamJoinedAt',
                'role',
                'attendanceDefaultStatus',
                'attendanceDefaultHistory',
                'activeTeamId',
                'schemaVersion',
                'membershipWriteToken'
              ])
            && (
              (
                request.resource.data.teamId == resource.data.teamId
                && request.resource.data.role == resource.data.role
                && request.resource.data.get(
                    'teamJoinedAt',
                    null
                  ) == resource.data.get('teamJoinedAt', null)
                && request.resource.data.get(
                    'attendanceDefaultStatus',
                    'attending'
                  ) == resource.data.get(
                    'attendanceDefaultStatus',
                    'attending'
                  )
                && request.resource.data.get(
                    'attendanceDefaultHistory',
                    []
                  ) == resource.data.get('attendanceDefaultHistory', [])
              )
              || (
                resource.data.teamId == null
                && request.resource.data.teamId is string
                && request.resource.data.teamJoinedAt == request.time
                && existsAfter(teamPath(request.resource.data.teamId))
                && request.resource.data.attendanceDefaultStatus == 'attending'
                && request.resource.data.attendanceDefaultHistory.size() == 0
                && (
                  request.resource.data.role == 'player'
                  || (
                    request.resource.data.role == 'admin'
                    && getAfter(
                      teamPath(request.resource.data.teamId)
                    ).data.createdBy == request.auth.uid
                  )
                )
              )
              || (
                resource.data.teamId is string
                && resource.data.role in ['admin', 'player']
                && request.resource.data.teamId == null
                && request.resource.data.get('teamJoinedAt', null) == null
                && request.resource.data.role == 'player'
                && request.resource.data.attendanceDefaultStatus == 'attending'
                && request.resource.data.attendanceDefaultHistory.size() == 0
              )
              || (
                resource.data.teamId is string
                && resource.data.role in ['admin', 'player']
                && request.resource.data.teamId is string
                && request.resource.data.teamId != resource.data.teamId
                && request.resource.data.teamJoinedAt == request.time
                && request.resource.data.role == 'player'
                && existsAfter(teamPath(request.resource.data.teamId))
                && request.resource.data.attendanceDefaultStatus == 'attending'
                && request.resource.data.attendanceDefaultHistory.size() == 0
              )
              || (
                // Multi-team: mirror an active membership the user owns onto
                // their profile (join another team as a player, or switch the
                // active team back to one where they hold a coach role).
                // Uses *After so the membership created in this same batch is
                // visible.
                request.auth.uid == userId
                && request.resource.data.teamId is string
                && request.resource.data.teamId != resource.data.teamId
                && request.resource.data.activeTeamId == request.resource.data.teamId
                && existsAfter(membershipPath(request.resource.data.teamId, request.auth.uid))
                && getAfter(membershipPath(request.resource.data.teamId, request.auth.uid))
                    .data.active == true
                && getAfter(membershipPath(request.resource.data.teamId, request.auth.uid))
                    .data.role == request.resource.data.role
              )
            )
          )
          || (
            isTeamCoach(resource.data.teamId)
            && request.auth.uid != userId
            && !isTeamOwner(resource.data.teamId, userId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'teamId',
                'teamJoinedAt',
                'role',
                'attendanceDefaultStatus',
                'attendanceDefaultHistory',
                'activeTeamId',
                'schemaVersion',
                'membershipWriteToken'
              ])
            && (
              request.resource.data.get('managedByCoach', false) == false
              || request.resource.data.role == 'player'
            )
            && (
              (
                request.resource.data.teamId == resource.data.teamId
                && request.resource.data.get(
                    'teamJoinedAt',
                    null
                  ) == resource.data.get('teamJoinedAt', null)
                && request.resource.data.role in ['admin', 'player']
              )
              || (
                request.resource.data.teamId == null
                && request.resource.data.get('teamJoinedAt', null) == null
                && request.resource.data.role == 'player'
              )
            )
          )
        );

      allow delete: if isAuthenticated()
        && request.auth.uid != userId
        && resource.data.teamId is string
        && resource.data.get('managedByCoach', false) == true
        && isTeamCoach(resource.data.teamId);
    }

    match /teamMemberships/{membershipId} {
      function hasMatchingId() {
        return request.resource.data.teamId + '__' + request.resource.data.memberId
          == membershipId;
      }

      // A user can read their own membership(s), and any member of a team can
      // read that team's roster. Reads of a not-yet-existing document are also
      // allowed so transactions can check whether a membership already exists.
      allow read: if isAuthenticated()
        && (
          !exists(/databases/$(database)/documents/teamMemberships/$(membershipId))
          || resource.data.memberId == request.auth.uid
          || resource.data.userId == request.auth.uid
          || belongsToTeam(resource.data.teamId)
        );

      allow create: if isAuthenticated()
        && hasValidMembershipShape(request.resource.data)
        && hasMatchingId()
        && (
          (
            // Self-join as a player via a valid team code.
            request.resource.data.memberId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'player'
            && request.resource.data.managedByCoach == false
            && exists(teamPath(request.resource.data.teamId))
            && get(teamPath(request.resource.data.teamId)).data.joinCode
              == request.resource.data.teamId
          )
          || (
            // Owner creating their own admin membership during createTeam.
            request.resource.data.memberId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'admin'
            && request.resource.data.managedByCoach == false
            && existsAfter(teamPath(request.resource.data.teamId))
            && getAfter(teamPath(request.resource.data.teamId)).data.createdBy
              == request.auth.uid
          )
          || (
            // Coach creating a managed player (no account).
            request.resource.data.memberId != request.auth.uid
            && request.resource.data.userId == null
            && request.resource.data.role == 'player'
            && request.resource.data.managedByCoach == true
            && isTeamCoach(request.resource.data.teamId)
          )
        );

      allow update: if isAuthenticated()
        && hasValidMembershipShape(request.resource.data)
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('managedByCoach', false)
          == resource.data.get('managedByCoach', false)
        && (
          (
            // A coach managing a roster member (never the owner, never self).
            isTeamCoach(resource.data.teamId)
            && request.auth.uid != resource.data.memberId
            && !isTeamOwner(resource.data.teamId, resource.data.memberId)
            && (
              resource.data.get('managedByCoach', false) == false
              || request.resource.data.role == 'player'
            )
          )
          || (
            // A member deactivating their own membership (leaving the team).
            request.auth.uid == resource.data.memberId
            && request.resource.data.fullName == resource.data.fullName
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('attendanceDefaultStatus', 'attending')
              == resource.data.get('attendanceDefaultStatus', 'attending')
            && request.resource.data.get('attendanceDefaultHistory', [])
              == resource.data.get('attendanceDefaultHistory', [])
          )
        );

      allow delete: if isAuthenticated()
        && isTeamCoach(resource.data.teamId)
        && resource.data.get('managedByCoach', false) == true
        && resource.data.memberId != request.auth.uid
        && !isTeamOwner(resource.data.teamId, resource.data.memberId);
    }

    match /sessions/{sessionId} {
      allow read: if belongsToTeam(resource.data.teamId);
      allow create: if isTeamCoach(request.resource.data.teamId)
        && request.resource.data.keys().hasOnly([
          'teamId',
          'title',
          'startTime',
          'endTime',
          'recurrenceSeriesId',
          'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime;
      allow update: if isTeamCoach(resource.data.teamId)
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.recurrenceSeriesId
          == resource.data.recurrenceSeriesId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isTeamCoach(resource.data.teamId);

      match /attendance/{userId} {
        function parentSession() {
          return get(
            /databases/$(database)/documents/sessions/$(sessionId)
          ).data;
        }

        function canEditAttendance() {
          return belongsToTeam(parentSession().teamId)
            && ((request.auth.uid == userId
                && request.time < parentSession().endTime)
              || isTeamCoach(parentSession().teamId));
        }

        function targetIsPlayer() {
          return exists(membershipPath(parentSession().teamId, userId))
            && get(membershipPath(parentSession().teamId, userId)).data.active == true
            && get(membershipPath(parentSession().teamId, userId)).data.role == 'player';
        }

        allow read: if belongsToTeam(parentSession().teamId);
        allow create: if canEditAttendance()
          && targetIsPlayer()
          && request.resource.data.keys().hasOnly([
            'status',
            'note',
            'updatedBy',
            'updatedAt'
          ])
          && hasValidAttendanceShape(request.resource.data)
          && (isTeamCoach(parentSession().teamId)
            || isPlayerAttendanceStatus(request.resource.data.status));
        allow update: if canEditAttendance()
          && targetIsPlayer()
          && request.resource.data.keys().hasOnly([
            'status',
            'note',
            'updatedBy',
            'updatedAt'
          ])
          && hasValidAttendanceShape(request.resource.data)
          && (isTeamCoach(parentSession().teamId)
            || (isPlayerAttendanceStatus(resource.data.status)
              && isPlayerAttendanceStatus(request.resource.data.status)));
        allow delete: if canEditAttendance()
          && targetIsPlayer()
          && (isTeamCoach(parentSession().teamId)
            || isPlayerAttendanceStatus(resource.data.status));
      }
    }
  }
}
